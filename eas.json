{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "store",
      "android": {
        "credentialsSource": "remote"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-ios-simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "node": "22.15.0",
      "ios": {
        "image": "macos-sequoia-15.2-xcode-16.2"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "production"
      },
      "ios": {
        "appleId": "moataz.alsbak86@gmail.com",
        "ascAppId": "FILL_IN_AFTER_CREATING_APP_IN_APPSTORE_CONNECT",
        "appleTeamId": "DC5476F3WM"
      }
    }
  }
}
